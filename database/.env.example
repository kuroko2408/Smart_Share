# =============================================================================
# Smart Share — Database Environment Variables Example
# =============================================================================
# Copy to backend/.env. Do NOT commit backend/.env.

# Option 1: Local Docker PostgreSQL + PostGIS (default dev port 5433)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/smart_share

# Option 2: Hosted Supabase PostgreSQL + PostGIS
# Replace [YOUR-PASSWORD], [YOUR-PROJECT-REF], and [REGION] with your Supabase credentials.
# Note: For Supabase session connection:
# DATABASE_URL=postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# For Supabase transaction pooling (serverless):
# DATABASE_URL=postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?prepared_statement_cache_size=0
