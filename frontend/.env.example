# Frontend Environment Variables — Example
# Copy this file to .env.local and fill in your values.
# Do NOT commit .env.local — it is in .gitignore.

# Base URL of the backend API
VITE_API_BASE_URL=http://localhost:8000

# Supabase project URL and anon/public key (safe for client-side use)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Routing provider base URL (openrouteservice or compatible)
VITE_ORS_BASE_URL=https://api.openrouteservice.org
# VITE_ORS_API_KEY is handled server-side — do not expose it here
