APP_ENV=development
APP_NAME=Smart Share
API_V1_PREFIX=/api/v1

# Database connection string (PostgreSQL + PostGIS)
# Local Docker default: postgresql+asyncpg://postgres:postgres@localhost:5433/smart_share
# Supabase: postgresql+asyncpg://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL=

# Supabase Auth configuration
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=RS256,ES256
SUPABASE_JWT_SECRET=
JWKS_CACHE_LIFESPAN=300

ROUTING_PROVIDER=
ROUTING_API_KEY=
ROUTING_TIMEOUT_SECONDS=5
OSRM_BASE_URL=https://router.project-osrm.org

CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
