APP_ENV=development
APP_NAME=Smart Share
API_V1_PREFIX=/api/v1

# Database connection string (PostgreSQL + PostGIS)
# Local Docker default: postgresql+asyncpg://postgres:postgres@localhost:5433/smart_share
# Supabase: postgresql+asyncpg://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL=

SUPABASE_URL=
SUPABASE_JWKS_URL=

ROUTING_PROVIDER=
ROUTING_API_KEY=

CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
