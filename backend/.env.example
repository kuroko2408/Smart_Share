# Backend Environment Variables — Example
# Copy this file to .env and fill in your values.
# Do NOT commit .env — it is in .gitignore.

# Application environment: development | test | production
APP_ENV=development

# PostgreSQL / Supabase connection string
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@localhost:5432/smart_share

# Supabase JWT secret — used to verify user tokens from Supabase Auth
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Openrouteservice API key (server-side only — never expose to the client)
ORS_API_KEY=your-openrouteservice-api-key

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173
